{
  "rewrites": [
    {
      "source": "/nota/:id",
      "destination": "/nota.html?id=:id"
    },
    {
      "source": "/shared/:shareId",
      "destination": "/nota.html?shareId=:shareId"
    },
    {
      "source": "/api/shared/create-share-link",
      "destination": "/api/shared/create-share-link.js"
    },
    {
      "source": "/api/shared/:shareId",
      "destination": "/api/shared/[shareId].js"
    }
  ]
}
